page{background:#f7f4ed;color:#253b35;font-family:system-ui,sans-serif;font-size:34rpx;line-height:1.65}button{font-size:32rpx;border-radius:18rpx;margin:16rpx 0;background:#e9eee5;color:#253b35}button::after{border:0}button[disabled]{opacity:.5}button.primary{background:#245a48;color:#fff}button.stop{background:#863d32;color:#fff}button.small{font-size:28rpx;padding:6rpx 18rpx;line-height:1.8}input{background:#fff;border:1rpx solid #d9dace;padding:20rpx;border-radius:12rpx}text{overflow-wrap:break-word}.muted{color:#65756c;font-size:27rpx}.error{color:#8c2c24;background:#fff0e8;padding:20rpx;border-radius:12rpx}.row{display:flex;gap:16rpx;align-items:center;flex-wrap:wrap}.row button{flex:1}.card{background:#fffdf7;border:1rpx solid #dddccf;border-radius:22rpx;padding:28rpx;margin:24rpx 0}.title{font-size:42rpx;font-weight:600}.body{white-space:pre-wrap}.empty{padding:30rpx 0;color:#65756c}
